# Cloudflare Pages headers. The page itself is never cached: this site gets
# edited often and is checked on a phone, where a stale copy is hard to shake.
/index.html
  Cache-Control: no-store

/
  Cache-Control: no-store

# Film files are immutable enough to keep in the browser cache; this lets
# revisits and range seeks reuse the downloaded media instead of re-fetching.
/web/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
